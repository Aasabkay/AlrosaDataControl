# Секреты прод-стека. Скопируйте в deploy/.env и заполните свои значения.
# Файл deploy/.env в репозиторий не попадает.

DB_USER=alrosa_user
# ОБЯЗАТЕЛЬНО смените: латиница, цифры, символы; без кавычек и пробелов.
DB_PASSWORD=change_me_strong_password
DB_NAME=alrosa_assets

# Секрет для подписи JWT. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_generate_a_random_64_hex_string

# Шапка отчёта (видна в предпросмотре и в XLSX). Можно оставить пустым.
REPORT_ORGANIZATION=АЛРОСА
REPORT_RESPONSIBLE=Служба ИТ
